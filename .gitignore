# ===========================
# Spring Boot / Maven (Backend)
# ===========================

# Compiled class files & build output
**/target/

# Maven wrapper jar
**/.mvn/wrapper/maven-wrapper.jar

# IntelliJ IDEA
**/.idea/
**/*.iml
**/*.iws
**/*.ipr

# Eclipse
**/.classpath
**/.project
**/.settings/
**/.factorypath

# VS Code
**/.vscode/

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
**/*.log
**/logs/

# ===========================
# Vue.js / Node.js (Frontend)
# ===========================

# Dependencies
**/node_modules/

# Build output
**/dist/

# Local env files
**/.env
**/.env.local
**/.env.*.local

# Editor directories and files
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# ===========================
# Large / binary files
# ===========================

# Zip archives (remove this line if you want to track them)
**/*.zip

# ===========================
# Misc
# ===========================

# Package lock can be kept but is large — uncomment to ignore:
# **/package-lock.json
